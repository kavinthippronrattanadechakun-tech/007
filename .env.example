NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public publishable key or legacy anon key, never a secret/service_role key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only
SUPABASE_SERVICE_ROLE_KEY=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Server-only EasySlip API v2. Register the receiver account in EasySlip first.
EASYSLIP_API_KEY=
# Optional: false keeps manual review even with a key.
SLIP_AUTO_VERIFY_ENABLED=
# Optional 3-digit BOT code if the bank name cannot be recognized.
EASYSLIP_RECEIVER_BANK_CODE=

# Optional alternative, server-only. Takes priority over EasySlip when set.
SLIPVERIFY_API_TOKEN=
