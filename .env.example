NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public publishable key or legacy anon key, never a secret/service_role key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only
SUPABASE_SERVICE_ROLE_KEY=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Server-only SlipOK: register the same receiver account in the API branch.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
SLIPOK_CYCLE_DAY=8

# LINE Messaging API (server only). Configure in Vercel Production, never NEXT_PUBLIC.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Optional: authenticate the daily recovery cron (long random secret).
CRON_SECRET=
